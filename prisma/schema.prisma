// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Folder {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  color       String?

  parentId String?
  parent   Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Folder[] @relation("FolderHierarchy")

  notes Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Note {
  id      String  @id @default(cuid())
  title   String
  slug    String  @unique
  content String  @default("")
  excerpt String?

  isFavorite Boolean @default(false)
  isArchived Boolean @default(false)

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  tags          NoteTag[]
  outgoingLinks NoteLink[] @relation("SourceNote")
  incomingLinks NoteLink[] @relation("TargetNote")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folderId])
  @@index([updatedAt])
}

model Tag {
  id    String  @id @default(cuid())
  name  String  @unique
  slug  String  @unique
  color String?

  notes NoteTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NoteTag {
  noteId String
  tagId  String

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
}

model NoteLink {
  sourceNoteId String
  targetNoteId String

  sourceNote Note @relation("SourceNote", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNote Note @relation("TargetNote", fields: [targetNoteId], references: [id], onDelete: Cascade)

  @@id([sourceNoteId, targetNoteId])
  @@index([targetNoteId])
}

model Task {
  id            String    @id @default(cuid())
  title         String
  description   String    @default("")
  dueDate       DateTime?
  priority      String    @default("MEDIUM")
  isCompleted   Boolean   @default(false)
  isHighlighted Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projectId     String?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([dueDate])
  @@index([isCompleted])
  @@index([isHighlighted])
  @@index([projectId])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  status      String    @default("ACTIVE")
  priority    String    @default("MEDIUM")
  deadline    DateTime?
  completedAt DateTime?
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  areaId      String?

  area  Area?  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  tasks Task[]

  @@index([status])
  @@index([deadline])
  @@index([isArchived])
  @@index([areaId])
}

model Area {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  icon        String   @default("Layers")
  color       String   @default("#A84F37")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects  Project[]
  resources Resource[]

  @@index([isArchived])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  url         String   @default("")
  type        String   @default("ARTICLE")
  status      String   @default("TO_RIVIEW")
  isFavorit   Boolean  @default(false)
  isArchived  Boolean  @default(false)
  areaId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  area Area? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([isFavorit])
  @@index([isArchived])
  @@index([areaId])
}
